# Copy to backend/.env and set your own password before starting.
# The root docker-compose.yml reads this same file; no root .env is needed.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catchy_toilet
POSTGRES_USER=catchy_toilet
POSTGRES_PASSWORD=

# Connection/pool wait in seconds; SQL statement timeout in milliseconds.
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000

# Statistics: minimum valid observations and rolling historical window (days).
# Hourly buckets use Asia/Seoul. Test snapshots are excluded.
MIN_STAT_SAMPLE_COUNT=30
STAT_LOOKBACK_DAYS=56

# Compare historical availability only within this many meters of the nearest
# currently eligible restroom. Zero permits only exact-distance ties.
RECOMMENDATION_DISTANCE_TOLERANCE=10

# Docker Compose host port for the API.
API_PORT=8000

# Browser frontend origins, as a JSON array. Match the actual scheme/host/port.
# Use [] to disable cross-origin browser access. Native mobile/IoT do not use CORS.
CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]'
