# Copy to backend/.env and set your own password before starting.
# The root docker-compose.yml reads this same file; no root .env is needed.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catchy_toilet
POSTGRES_USER=catchy_toilet
POSTGRES_PASSWORD=

# Admin credentials above are used only by PostgreSQL and the migration job.
# The API receives this separate, restricted runtime account (32+ char password).
APP_DB_USER=catchy_toilet_app
APP_DB_PASSWORD=

# Connection/pool wait in seconds; SQL statement timeout in milliseconds.
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000

# Statistics: minimum valid observations and rolling historical window (days).
# Hourly buckets use Asia/Seoul. Test snapshots are excluded.
MIN_STAT_SAMPLE_COUNT=30
STAT_LOOKBACK_DAYS=56

# Compare historical availability only within this many meters of the nearest
# currently eligible restroom. Zero permits only exact-distance ties.
RECOMMENDATION_DISTANCE_TOLERANCE=10

# Device-specific secrets, JSON object: device_id -> unique secret.
# Generate each secret with secrets.token_urlsafe(32); never commit real keys.
# {} disables sensor writes (503); reads and WebSocket remain available.
SENSOR_API_KEYS='{}'
ENABLE_SIMULATION=false
# PC simulation only. Generate a distinct secrets.token_urlsafe(32); never put it in Flutter.
SIMULATION_API_KEY=
SENSOR_RATE_PER_SECOND=0.2
SENSOR_RATE_BURST=2
SENSOR_GLOBAL_RATE_PER_SECOND=5
SENSOR_GLOBAL_BURST=10
SENSOR_MIN_STATE_INTERVAL_SECONDS=1
# Delete at most 1,000 expired raw events/minute; derived snapshots are retained.
SENSOR_EVENT_RETENTION_DAYS=90

WS_MAX_CONNECTIONS=100
WS_MAX_CONNECTIONS_PER_IP=10
# Empty list uses CORS_ALLOWED_ORIGINS. Native clients without Origin are allowed.
WS_ALLOWED_ORIGINS='[]'

# Docker Compose host address/port. Keep loopback for local/iOS simulator use.
# Set the LAN interface IP explicitly when connecting physical IoT devices.
API_BIND_HOST=127.0.0.1
API_PORT=8000

# Browser frontend origins, as a JSON array. Match the actual scheme/host/port.
# Use [] to disable cross-origin browser access. Native mobile/IoT do not use CORS.
CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]'
