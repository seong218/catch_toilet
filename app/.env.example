# Reference only. Flutter does not automatically load .env files.
# Pass these as --dart-define values, or use --dart-define-from-file=.env.local.
# flutter run --dart-define=USE_MOCK=false --dart-define=API_BASE_URL=http://10.0.2.2:8000
USE_MOCK=false
API_BASE_URL=http://localhost:8000
# Kakao Developers > App > App keys > Native app key.
# Register Android package/key hash and iOS Bundle ID; enable Kakao Map.
# Use the account's first free-quota map app and leave paid APIs disabled.
# Never put an Admin key or Client Secret in the app. See docs/KAKAO_MAP_SETUP.md.
KAKAO_NATIVE_APP_KEY=
